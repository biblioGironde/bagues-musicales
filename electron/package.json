{
  "name": "bagues-musicales",
  "productName": "Bagues musicales",
  "version": "1.1.0",
  "description": "Webapp Specdrums Mix pour les bagues musicales Sphero Specdrums (version démo libre)",
  "author": "biblio.gironde",
  "homepage": "https://github.com/biblioGironde/bagues-musicales",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "python3 ../tools/build.py --demo --out app/index.html && node -e \"require('fs').copyFileSync('../test/specdrums-test.html','app/test.html')\"",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --publish never",
    "release": "npm run prepare-app && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "fr.gironde.biblio.bagues-musicales",
    "productName": "Bagues musicales",
    "artifactName": "Bagues-musicales-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Bagues musicales se connecte en Bluetooth à vos bagues Specdrums.",
        "NSBluetoothPeripheralUsageDescription": "Bagues musicales se connecte en Bluetooth à vos bagues Specdrums."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bagues-musicales-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Bagues-musicales-${version}-windows-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "biblioGironde",
        "repo": "bagues-musicales",
        "releaseType": "release"
      }
    ]
  }
}
